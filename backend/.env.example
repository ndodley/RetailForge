# Database
POSTGRES_DB=department_store1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App
PORT=5000
SESSION_SECRET=your_session_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret

# Kafka (optional)
# To enable publishing/consuming events locally, run docker compose (see README)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=retailforge-backend
KAFKA_TOPIC_ORDERS=rf.orders
KAFKA_TOPIC_AUTH=rf.auth
KAFKA_TOPIC_INVENTORY=rf.inventory

# Inventory alerts
LOW_STOCK_THRESHOLD=5
